# ════════════════════════════════════════════════════════════════════════════
# MANARA — Environment Example (NO REAL SECRETS HERE)
# ════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` for local development and replace placeholder values.
# Never commit the real `.env`. Never read secrets from public ZIPs (e.g.
# repo-info/START-HERE/GeneralGH.zip is NOT an approved credential source).
# All values below are intentionally empty or non-sensitive placeholders.
# ════════════════════════════════════════════════════════════════════════════

# ── Runtime environment ──────────────────────────────────────────────────────
# One of: development | staging | production
MANARA_ENV=development
MANARA_LOG_LEVEL=INFO
MANARA_PORT=8000
MANARA_HOST=0.0.0.0

# ── Database ──────────────────────────────────────────────────────────────────
# Production target: PostgreSQL. Development/test default: SQLite (lightweight
# dev variant per G00 spec — "lightweight dev variant permitted if integration
# is ready"). Switch DATABASE_URL to a postgres DSN when running against the
# real PostgreSQL service defined in docker-compose.yml.
DATABASE_URL=sqlite:///./manara_dev.db
# Example PostgreSQL target (DO NOT enable without secrets manager):
# DATABASE_URL=postgresql+psycopg://manara:CHANGE_ME@localhost:5432/manara
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=MANARA

# ── Security / Tenancy ───────────────────────────────────────────────────────
# Run in single-tenant demo mode when "true". Multi-tenant enforcement (G03+)
# will replace this with proper authentication.
MANARA_SINGLE_TENANT_DEMO=true
MANARA_DEFAULT_TENANT_ID=tenant_demo

# ── Synthetic / Mock switches (G00) ─────────────────────────────────────────
# Discovery view returns synthetic-only content. Real connectors are deferred
# to G02. This flag is here so the API explicitly labels mock outputs.
MANARA_DISCOVERY_MODE=synthetic

# ── Reserved placeholders for future missions (DO NOT FILL HERE) ─────────────
# These keys exist only to document where future private injection will happen.
# NEVER place real tokens here. Use the approved secrets manager.
# LLM_PROVIDER_API_KEY=
# SEARCH_PROVIDER_API_KEY=
# OBJECT_STORAGE_S3_ACCESS_KEY=
# OBJECT_STORAGE_S3_SECRET_KEY=
