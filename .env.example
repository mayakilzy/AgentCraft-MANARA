# ════════════════════════════════════════════════════════════════════════════
# MANARA — Environment Example for Staging (NO REAL SECRETS HERE)
# ════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` for Docker Compose Staging deployment.
# All values use ${VAR:-default} syntax in docker-compose.yml so these
# are overrides, not required. But POSTGRES_PASSWORD MUST be changed.
# ════════════════════════════════════════════════════════════════════════════

# ── Runtime environment ──────────────────────────────────────────────────────
MANARA_ENV=staging
MANARA_DISCOVERY_MODE=synthetic
MANARA_SINGLE_TENANT_DEMO=true
MANARA_DEFAULT_TENANT_ID=tenant_demo

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# These are read by docker-compose.yml via ${VAR:-default}.
# CHANGE THE PASSWORD before any real deployment.
POSTGRES_USER=manara
POSTGRES_PASSWORD=CHANGE_ME_IN_STAGING
POSTGRES_DB=manara

# ── Object storage ──────────────────────────────────────────────────────────
MANARA_OBJECT_STORE=local
# For S3 production:
# MANARA_OBJECT_STORE=s3
# MANARA_S3_BUCKET=manara-snapshots

# ── API keys (optional, for live features) ─────────────────────────────────
# Uncomment and set for live LLM execution:
# MANARA_ZAI_API_KEY=your-zai-api-key-here
# Uncomment and set for reliable OpenAlex search:
# MANARA_OPENALEX_API_KEY=your-openalex-api-key-here
